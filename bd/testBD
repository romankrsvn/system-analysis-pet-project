-- =========================================
-- USERS
-- =========================================
CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name TEXT NOT NULL,
    surname TEXT NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    is_archived BOOLEAN NOT NULL DEFAULT FALSE
);

-- =========================================
-- REF_STATUS
-- =========================================
CREATE TABLE ref_status (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    short_name VARCHAR(100),
    description TEXT,
    created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    is_archived BOOLEAN NOT NULL DEFAULT FALSE
);

-- =========================================
-- EVENT
-- =========================================
CREATE TABLE event (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    author_id BIGINT NOT NULL,
    name VARCHAR(255) NOT NULL,
    description TEXT,
    date TIMESTAMP NOT NULL,
    place VARCHAR(255) NOT NULL,
    created TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    is_archived BOOLEAN NOT NULL DEFAULT FALSE,

    CONSTRAINT fk_event_users
        FOREIGN KEY (author_id)
        REFERENCES users(id)
);

-- =========================================
-- MEMBERS
-- =========================================
CREATE TABLE members (
    id BIGINT PRIMARY KEY AUTO_INCREMENT,
    user_id BIGINT NOT NULL,
    status_id BIGINT NOT NULL,
    event_id BIGINT NOT NULL,

    CONSTRAINT fk_members_users
        FOREIGN KEY (user_id)
        REFERENCES users(id),

    CONSTRAINT fk_members_ref_status
        FOREIGN KEY (status_id)
        REFERENCES ref_status(id),

    CONSTRAINT fk_members_event
        FOREIGN KEY (event_id)
        REFERENCES event(id)
);

-- =========================================
-- INDEXES
-- =========================================
CREATE INDEX idx_members_user_id
    ON members(user_id);

CREATE INDEX idx_members_status_id
    ON members(status_id);

CREATE INDEX idx_members_event_id
    ON members(event_id);

CREATE INDEX idx_event_author_id
    ON event(author_id);

